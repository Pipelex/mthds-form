domain      = "composites"
description = "A result made of several parts at once: a Markdown summary, a list of records and a generated picture, composed by a parallel run into one native.Composite."

# A composite declares no members, so its descriptor is `kind: "unknown"` and
# the renderer reads each member as the content it is by definition. This case
# gives it the three members a multi-part report has: prose, a list of `Risk`
# records, and an image. The carriers are synthesized from
# composites.slots.json: a `PipeParallel` naming three branch carriers, which
# the payload pass runs through the parallel rather than on their own.

[concept.Risk]
description = "A risk to a product launch"

[concept.Risk.structure]
risk = { type = "text", description = "The risk", required = true }
likelihood = { type = "text", description = "How likely it is", required = true, choices = [
  "low",
  "medium",
  "high",
] }
