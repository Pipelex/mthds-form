{"op":"add","path":"/root","value":"page"}
{"op":"add","path":"/elements/page","value":{"type":"Stack","props":{"direction":"vertical","gap":"xl","align":"stretch"},"children":["header-region","cost-region","days-grid","practical-notes"]}}
{"op":"add","path":"/elements/header-region","value":{"type":"Stack","props":{"direction":"vertical","gap":"lg"},"children":["trip-header"]}}
{"op":"add","path":"/elements/trip-header","value":{"type":"ResultHeader","props":{"title":{"$state":"/result/title"},"subtitle":{"$state":"/result/overview"}},"children":[]}}
{"op":"add","path":"/elements/cost-region","value":{"type":"Stack","props":{"direction":"vertical","gap":"lg"},"children":["estimated-cost"]}}
{"op":"add","path":"/elements/estimated-cost","value":{"type":"ProportionBar","props":{"label":"Estimated trip cost","total":{"$state":"/result/estimated_total"},"items":{"$state":"/result/costs"},"labelKey":"category","valueKey":"amount","unit":{"$state":"/result/currency"}},"children":[]}}
{"op":"add","path":"/elements/days-grid","value":{"type":"Grid","props":{"columns":2,"gap":"xl"},"children":["day-plan"]}}
{"op":"add","path":"/elements/day-plan","value":{"type":"Stack","props":{"direction":"vertical","gap":"md","align":"stretch"},"repeat":{"statePath":"/result/days","key":"day"},"children":["day-date","day-title","morning-detail","lunch-detail","afternoon-detail","evening-detail"]}}
{"op":"add","path":"/elements/day-date","value":{"type":"DateText","props":{"value":{"$item":"day"},"style":"long","tone":"muted"},"children":[]}}
{"op":"add","path":"/elements/day-title","value":{"type":"Heading","props":{"text":{"$item":"title"},"level":"h2"},"children":[]}}
{"op":"add","path":"/elements/morning-detail","value":{"type":"Detail","props":{"label":"Morning","value":{"$item":"morning"}},"children":[]}}
{"op":"add","path":"/elements/lunch-detail","value":{"type":"Detail","props":{"label":"Lunch","value":{"$item":"midday"}},"children":[]}}
{"op":"add","path":"/elements/afternoon-detail","value":{"type":"Detail","props":{"label":"Afternoon","value":{"$item":"afternoon"}},"children":[]}}
{"op":"add","path":"/elements/evening-detail","value":{"type":"Detail","props":{"label":"Evening","value":{"$item":"evening"}},"children":[]}}
{"op":"add","path":"/elements/practical-notes","value":{"type":"Section","props":{"title":"Good to know"},"children":["notes-list"]}}
{"op":"add","path":"/elements/notes-list","value":{"type":"TextList","props":{"items":{"$state":"/result/practical_notes"},"marker":"bullet"},"children":[]}}