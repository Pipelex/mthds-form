{
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "alpha": 1,
        "hex": "#ffffff"
      },
      "$description": "The site is dark-only; its page background is #0a0a0b, so the light canvas here is the derived inversion: white.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.0392,
              0.0392,
              0.0431
            ],
            "alpha": 1,
            "hex": "#0a0a0b"
          }
        }
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0392,
          0.0392,
          0.0431
        ],
        "alpha": 1,
        "hex": "#0a0a0b"
      },
      "$description": "The site's body text is text-white on the dark canvas; the light ink here is the derived inversion of that canvas.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              1,
              1,
              1
            ],
            "alpha": 1,
            "hex": "#ffffff"
          }
        }
      }
    },
    "card": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0,
          0
        ],
        "alpha": 0.05
      },
      "$description": "A raised surface is bg-white/5 over the canvas; in light mode a step off white is the same faint fill inverted to black.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              1,
              1,
              1
            ],
            "alpha": 0.05
          }
        }
      }
    },
    "card-foreground": {
      "$value": "{color.foreground}",
      "$description": "Text on a card is the page ink, in both modes."
    },
    "popover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "alpha": 1,
        "hex": "#ffffff"
      },
      "$description": "A floating surface is opaque; the site's overlays sit on the near-black bg-bg-darker (#0d0b14), inverted to white for light mode.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.051,
              0.043,
              0.078
            ],
            "alpha": 1,
            "hex": "#0d0b14"
          }
        }
      }
    },
    "popover-foreground": {
      "$value": "{color.foreground}",
      "$description": "Text on a popover is the page ink, in both modes."
    },
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0.7333,
          0.5843
        ],
        "alpha": 1,
        "hex": "#00bb95"
      },
      "$description": "The accent is --accent-teal #00bb95, shown on text-accent-teal, bg-accent-teal buttons and borders across the page; the accent is kept in both modes.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0,
              0.7333,
              0.5843
            ],
            "alpha": 1,
            "hex": "#00bb95"
          }
        }
      }
    },
    "primary-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "alpha": 1,
        "hex": "#ffffff"
      },
      "$description": "Text on the teal accent is white, matching the site's filled teal buttons.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              1,
              1,
              1
            ],
            "alpha": 1,
            "hex": "#ffffff"
          }
        }
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0,
          0
        ],
        "alpha": 0.06
      },
      "$description": "A quiet filled surface is the site's bg-white/[0.06]; in light mode the same faint fill inverted to black.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              1,
              1,
              1
            ],
            "alpha": 0.06
          }
        }
      }
    },
    "secondary-foreground": {
      "$value": "{color.foreground}",
      "$description": "Text on a secondary surface is the page ink, in both modes."
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0,
          0
        ],
        "alpha": 0.03
      },
      "$description": "A subdued fill is the site's faintest bg-white/[0.03] band; inverted to black over the light canvas.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              1,
              1,
              1
            ],
            "alpha": 0.03
          }
        }
      }
    },
    "muted-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.4196,
          0.4471,
          0.502
        ],
        "alpha": 1,
        "hex": "#6b7280"
      },
      "$description": "Secondary text is the site's text-gray-400 (#9ca3af); darkened to gray-500 for the light canvas to hold the 4.5 contrast bar.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.6157,
              0.6392,
              0.6863
            ],
            "alpha": 1,
            "hex": "#9ca3af"
          }
        }
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0,
          0
        ],
        "alpha": 0.1
      },
      "$description": "A hover fill is the site's bg-white/10; inverted to a faint black over the light canvas.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              1,
              1,
              1
            ],
            "alpha": 0.1
          }
        }
      }
    },
    "accent-foreground": {
      "$value": "{color.foreground}",
      "$description": "Text on a hover fill is the page ink, in both modes."
    },
    "destructive": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9569,
          0.2471,
          0.3686
        ],
        "alpha": 1,
        "hex": "#f43f5e"
      },
      "$description": "The error colour is the site's bg-rose-500 / text-rose-400, used for remove and invalid marks.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.9843,
              0.4431,
              0.5216
            ],
            "alpha": 1,
            "hex": "#fb7185"
          }
        }
      }
    },
    "destructive-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "alpha": 1,
        "hex": "#ffffff"
      },
      "$description": "Text on the destructive colour is white, matching the site's filled rose buttons.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              1,
              1,
              1
            ],
            "alpha": 1,
            "hex": "#ffffff"
          }
        }
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0,
          0
        ],
        "alpha": 0.1
      },
      "$description": "The hairline is the site's border-white/10; inverted to black over the light canvas.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              1,
              1,
              1
            ],
            "alpha": 0.1
          }
        }
      }
    },
    "input": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0,
          0
        ],
        "alpha": 0.06
      },
      "$description": "The control surface is a step off the canvas, taken from the site's white/[0.06] field fill; inverted to black for light mode.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              1,
              1,
              1
            ],
            "alpha": 0.06
          }
        }
      }
    },
    "ring": {
      "$value": "{color.primary}",
      "$description": "The focus ring is the teal accent, matching the site's ring-accent-teal/30."
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": {
        "value": 0.75,
        "unit": "rem"
      },
      "$description": "The site's controls are rounded-xl (0.75rem), its most frequent square-cornered radius after pills."
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": {
      "$value": [
        "Inter",
        "ui-sans-serif",
        "system-ui",
        "sans-serif"
      ],
      "$description": "The site's one typeface is Inter, loaded as a web font, with the system stack behind it."
    },
    "mono": {
      "$value": [
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "Monaco",
        "Consolas",
        "monospace"
      ],
      "$description": "The site's font-mono utility resolves to the system monospace stack it declares."
    }
  }
}
