{
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "alpha": 1.0,
        "hex": "#ffffff"
      },
      "$description": "The page canvas. pipelex.com is dark by default: rgb(8 6 14), a near-black with a violet cast; the light mode is white.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.0314,
              0.0235,
              0.0549
            ],
            "alpha": 1.0,
            "hex": "#08060e"
          }
        }
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0314,
          0.0235,
          0.0549
        ],
        "alpha": 1.0,
        "hex": "#08060e"
      },
      "$description": "Text on the canvas: white on the dark canvas, the brand's near-black ink on the light one.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 1.0,
            "hex": "#ffffff"
          }
        }
      }
    },
    "card": {
      "$value": "{color.background}",
      "$description": "A raised surface. On the dark canvas the site's glass card, white at 4%; on the light canvas the canvas itself.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.04
          }
        }
      }
    },
    "card-foreground": {
      "$value": "{color.foreground}",
      "$description": "Text on a card.",
      "$extensions": {
        "mode": {
          "dark": "{color.foreground}"
        }
      }
    },
    "popover": {
      "$value": "{color.background}",
      "$description": "A floating surface such as a select's menu: opaque, one step above the canvas.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.0549,
              0.0471,
              0.0902
            ],
            "alpha": 1.0,
            "hex": "#0e0c17"
          }
        }
      }
    },
    "popover-foreground": {
      "$value": "{color.foreground}",
      "$description": "Text on a popover.",
      "$extensions": {
        "mode": {
          "dark": "{color.foreground}"
        }
      }
    },
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0,
          0.7333,
          0.5843
        ],
        "alpha": 1.0,
        "hex": "#00bb95"
      },
      "$description": "The brand accent, the site's teal (#00bb95): the run button, pills, focus, highlights. The same in both modes.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.0,
              0.7333,
              0.5843
            ],
            "alpha": 1.0,
            "hex": "#00bb95"
          }
        }
      }
    },
    "primary-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "alpha": 1.0,
        "hex": "#ffffff"
      },
      "$description": "Text on the accent: white, as the site's CTAs are.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 1.0,
            "hex": "#ffffff"
          }
        }
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9529,
          0.9529,
          0.9686
        ],
        "alpha": 1.0,
        "hex": "#f3f3f7"
      },
      "$description": "A quiet filled surface, a violet-tinted grey a step off the canvas.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.1098,
              0.102,
              0.1373
            ],
            "alpha": 1.0,
            "hex": "#1c1a23"
          }
        }
      }
    },
    "secondary-foreground": {
      "$value": "{color.foreground}",
      "$description": "Text on a secondary surface.",
      "$extensions": {
        "mode": {
          "dark": "{color.foreground}"
        }
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9333,
          0.9294,
          0.9529
        ],
        "alpha": 1.0,
        "hex": "#eeedf3"
      },
      "$description": "A subdued fill: the table header band, an inactive tab strip.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.098,
              0.0941,
              0.1255
            ],
            "alpha": 1.0,
            "hex": "#191820"
          }
        }
      }
    },
    "muted-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.4196,
          0.4471,
          0.502
        ],
        "alpha": 1.0,
        "hex": "#6b7280"
      },
      "$description": "Secondary text: the site's gray-400 on the dark canvas, gray-500 on the light one. Clears AA on the canvas in both modes.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.6118,
              0.6392,
              0.6863
            ],
            "alpha": 1.0,
            "hex": "#9ca3af"
          }
        }
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9059,
          0.902,
          0.9333
        ],
        "alpha": 1.0,
        "hex": "#e7e6ee"
      },
      "$description": "A hover fill, a step above secondary.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.1255,
              0.1176,
              0.1608
            ],
            "alpha": 1.0,
            "hex": "#201e29"
          }
        }
      }
    },
    "accent-foreground": {
      "$value": "{color.foreground}",
      "$description": "Text on an accent fill.",
      "$extensions": {
        "mode": {
          "dark": "{color.foreground}"
        }
      }
    },
    "destructive": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.8824,
          0.1137,
          0.2824
        ],
        "alpha": 1.0,
        "hex": "#e11d48"
      },
      "$description": "The error colour: the site's rose, used only for semantic marks.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.9569,
              0.2471,
              0.3686
            ],
            "alpha": 1.0,
            "hex": "#f43f5e"
          }
        }
      }
    },
    "destructive-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "alpha": 1.0,
        "hex": "#ffffff"
      },
      "$description": "Text on the destructive colour.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 1.0,
            "hex": "#ffffff"
          }
        }
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.8902,
          0.8863,
          0.9137
        ],
        "alpha": 1.0,
        "hex": "#e3e2e9"
      },
      "$description": "The hairline: the site's dominant border-white/10 on the dark canvas, a violet-tinted light grey on the light one.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              1.0,
              1.0
            ],
            "alpha": 0.1
          }
        }
      }
    },
    "input": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9765,
          0.9765,
          0.9843
        ],
        "alpha": 1.0,
        "hex": "#f9f9fb"
      },
      "$description": "The control surface, a field's own fill: a shade off the canvas so fields read as one family.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.0824,
              0.0745,
              0.1059
            ],
            "alpha": 1.0,
            "hex": "#15131b"
          }
        }
      }
    },
    "ring": {
      "$value": "{color.primary}",
      "$description": "The focus ring: the accent.",
      "$extensions": {
        "mode": {
          "dark": "{color.primary}"
        }
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": {
        "value": 0.75,
        "unit": "rem"
      },
      "$description": "The site's rounded-xl, on its cards and its call to action."
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": {
      "$value": [
        "Inter",
        "Inter Fallback",
        "ui-sans-serif",
        "system-ui",
        "sans-serif"
      ],
      "$description": "Inter, the site's one typeface, with the system stack behind it."
    },
    "mono": {
      "$value": [
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "Monaco",
        "Consolas",
        "monospace"
      ],
      "$description": "The site's mono stack, for tags and numbers."
    }
  }
}
