{
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "alpha": 1,
        "hex": "#ffffff"
      },
      "$description": "The page canvas: --md-default-bg-color, #fff in the served default scheme.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.0588,
              0.0588,
              0.0588
            ],
            "alpha": 1,
            "hex": "#0f0f0f"
          }
        }
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.3216,
          0.3216,
          0.3216
        ],
        "alpha": 1,
        "hex": "#525252"
      },
      "$description": "Text on the canvas: --md-default-fg-color / --md-typeset-color, #525252 as served.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.8314,
              0.8314,
              0.8314
            ],
            "alpha": 1,
            "hex": "#d4d4d4"
          }
        }
      }
    },
    "card": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9608,
          0.9608,
          0.9608
        ],
        "alpha": 1,
        "hex": "#f5f5f5"
      },
      "$description": "A raised surface: --md-code-bg-color / --md-default-bg-color--light, #f5f5f5, a step off the white canvas.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.102,
              0.102,
              0.102
            ],
            "alpha": 1,
            "hex": "#1a1a1a"
          }
        }
      }
    },
    "card-foreground": {
      "$value": "{color.foreground}",
      "$description": "Text on a card is the page ink, in both modes."
    },
    "popover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9804,
          0.9804,
          0.9804
        ],
        "alpha": 1,
        "hex": "#fafafa"
      },
      "$description": "A floating surface: --md-default-bg-color--lighter, #fafafa, an opaque step off the canvas.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.149,
              0.149,
              0.149
            ],
            "alpha": 1,
            "hex": "#262626"
          }
        }
      }
    },
    "popover-foreground": {
      "$value": "{color.foreground}",
      "$description": "Text on a popover is the page ink, in both modes."
    },
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.102,
          0.102,
          0.102
        ],
        "alpha": 1,
        "hex": "#1a1a1a"
      },
      "$description": "The accent, stated by the site owner: #1a1a1a in light mode, a near-black monochrome accent.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.898,
              0.898,
              0.898
            ],
            "alpha": 1,
            "hex": "#e5e5e5"
          }
        }
      }
    },
    "primary-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "alpha": 1,
        "hex": "#ffffff"
      },
      "$description": "Text on the accent: --md-primary-bg-color's contrasting ink, white on the dark primary in light mode.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.102,
              0.102,
              0.102
            ],
            "alpha": 1,
            "hex": "#1a1a1a"
          }
        }
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9608,
          0.9608,
          0.9608
        ],
        "alpha": 1,
        "hex": "#f5f5f5"
      },
      "$description": "A quiet filled surface: --md-primary-fg-color as served, #f5f5f5, a neutral fill off the canvas.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.102,
              0.102,
              0.102
            ],
            "alpha": 1,
            "hex": "#1a1a1a"
          }
        }
      }
    },
    "secondary-foreground": {
      "$value": "{color.foreground}",
      "$description": "Text on a secondary surface is the page ink, in both modes."
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9608,
          0.9608,
          0.9608
        ],
        "alpha": 1,
        "hex": "#f5f5f5"
      },
      "$description": "A subdued fill: the code band --md-code-bg-color, #f5f5f5.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.102,
              0.102,
              0.102
            ],
            "alpha": 1,
            "hex": "#1a1a1a"
          }
        }
      }
    },
    "muted-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.4196,
          0.4196,
          0.4196
        ],
        "alpha": 1,
        "hex": "#6b6b6b"
      },
      "$description": "Secondary text: --md-default-fg-color--light, #6b6b6b, meeting AA on the white canvas.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.6275,
              0.6275,
              0.6275
            ],
            "alpha": 1,
            "hex": "#a0a0a0"
          }
        }
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.3216,
          0.3216,
          0.3216
        ],
        "alpha": 1,
        "hex": "#525252"
      },
      "$description": "A hover fill: --md-accent-fg-color as served, #525252, the site's neutral interaction colour.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.8314,
              0.8314,
              0.8314
            ],
            "alpha": 1,
            "hex": "#d4d4d4"
          }
        }
      }
    },
    "accent-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "alpha": 1,
        "hex": "#ffffff"
      },
      "$description": "Text on an accent fill: white on the dark neutral hover, mirroring --md-accent-bg-color.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.102,
              0.102,
              0.102
            ],
            "alpha": 1,
            "hex": "#1a1a1a"
          }
        }
      }
    },
    "destructive": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.8353,
          0.1647,
          0.1647
        ],
        "alpha": 1,
        "hex": "#d52a2a"
      },
      "$description": "The error colour: --md-code-hl-number-color, #d52a2a, the site's red.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.902,
              0.4118,
              0.3569
            ],
            "alpha": 1,
            "hex": "#e6695b"
          }
        }
      }
    },
    "destructive-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "alpha": 1,
        "hex": "#ffffff"
      },
      "$description": "Text on the destructive colour: white, derived to sit on the red.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.0588,
              0.0588,
              0.0588
            ],
            "alpha": 1,
            "hex": "#0f0f0f"
          }
        }
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0,
          0
        ],
        "alpha": 0.12,
        "hex": "#000000"
      },
      "$description": "The hairline: --md-default-fg-color--lightest, black at 0.12 over the canvas.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.8314,
              0.8314,
              0.8314
            ],
            "alpha": 0.12,
            "hex": "#d4d4d4"
          }
        }
      }
    },
    "input": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9608,
          0.9608,
          0.9608
        ],
        "alpha": 1,
        "hex": "#f5f5f5"
      },
      "$description": "The control surface: derived as a neutral step off the canvas, matching the code/field fill #f5f5f5.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.102,
              0.102,
              0.102
            ],
            "alpha": 1,
            "hex": "#1a1a1a"
          }
        }
      }
    },
    "ring": {
      "$value": "{color.primary}",
      "$description": "The focus ring follows the accent, the stated primary, in both modes."
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": {
        "value": 0.1,
        "unit": "rem"
      },
      "$description": "The most frequent control radius on the site: .1rem."
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": {
      "$value": [
        "Roboto",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ],
      "$description": "The site's typeface for everything: Roboto, loaded from Google Fonts, with a system stack behind it."
    },
    "mono": {
      "$value": [
        "Roboto Mono",
        "SFMono-Regular",
        "Menlo",
        "monospace"
      ],
      "$description": "The site's monospace for tags, numbers and code: Roboto Mono, with the system stack behind it."
    }
  }
}
