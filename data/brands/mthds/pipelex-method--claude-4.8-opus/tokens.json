{
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "alpha": 1,
        "hex": "#ffffff"
      },
      "$description": "The site's page canvas: --md-default-bg-color is #ffffff in the default scheme; #0f0f0f in the slate scheme.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.0588,
              0.0588,
              0.0588
            ],
            "alpha": 1,
            "hex": "#0f0f0f"
          }
        }
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.3216,
          0.3216,
          0.3216
        ],
        "alpha": 1,
        "hex": "#525252"
      },
      "$description": "The site's body text: --md-default-fg-color as served is #525252 in the default scheme; #d4d4d4 in the slate scheme.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.8314,
              0.8314,
              0.8314
            ],
            "alpha": 1,
            "hex": "#d4d4d4"
          }
        }
      }
    },
    "card": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9804,
          0.9804,
          0.9804
        ],
        "alpha": 1,
        "hex": "#fafafa"
      },
      "$description": "A raised surface: --md-default-bg-color--lighter is #fafafa in the default scheme, a step off the white canvas; #262626 in the slate scheme.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.149,
              0.149,
              0.149
            ],
            "alpha": 1,
            "hex": "#262626"
          }
        }
      }
    },
    "card-foreground": {
      "$value": "{color.foreground}",
      "$description": "Text on a card is the site's ordinary ink; MkDocs draws surface text in --md-default-fg-color.",
      "$extensions": {
        "mode": {
          "dark": "{color.foreground}"
        }
      }
    },
    "popover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "alpha": 1,
        "hex": "#ffffff"
      },
      "$description": "A floating surface: MkDocs menus and tooltips sit on --md-default-bg-color, #ffffff in the default scheme; #0f0f0f in the slate scheme.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.0588,
              0.0588,
              0.0588
            ],
            "alpha": 1,
            "hex": "#0f0f0f"
          }
        }
      }
    },
    "popover-foreground": {
      "$value": "{color.foreground}",
      "$description": "Text on a popover is the site's ordinary ink, --md-default-fg-color.",
      "$extensions": {
        "mode": {
          "dark": "{color.foreground}"
        }
      }
    },
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9608,
          0.9608,
          0.9608
        ],
        "alpha": 1,
        "hex": "#f5f5f5"
      },
      "$description": "The site's primary surface: --md-primary-fg-color as served is a near-white grey #f5f5f5 in the default scheme; the dark grey #1a1a1a in the slate scheme.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.102,
              0.102,
              0.102
            ],
            "alpha": 1,
            "hex": "#1a1a1a"
          }
        }
      }
    },
    "primary-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.102,
          0.102,
          0.102
        ],
        "alpha": 1,
        "hex": "#1a1a1a"
      },
      "$description": "Text on the primary surface: --md-primary-bg-color as served is #1a1a1a in the default scheme; #e5e5e5 in the slate scheme.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.898,
              0.898,
              0.898
            ],
            "alpha": 1,
            "hex": "#e5e5e5"
          }
        }
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9608,
          0.9608,
          0.9608
        ],
        "alpha": 1,
        "hex": "#f5f5f5"
      },
      "$description": "A quiet filled surface: --md-code-bg-color / --md-default-bg-color--light is #f5f5f5 in the default scheme; #1a1a1a in the slate scheme.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.102,
              0.102,
              0.102
            ],
            "alpha": 1,
            "hex": "#1a1a1a"
          }
        }
      }
    },
    "secondary-foreground": {
      "$value": "{color.foreground}",
      "$description": "Text on the secondary surface is the site's ordinary ink, --md-default-fg-color.",
      "$extensions": {
        "mode": {
          "dark": "{color.foreground}"
        }
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9608,
          0.9608,
          0.9608
        ],
        "alpha": 1,
        "hex": "#f5f5f5"
      },
      "$description": "A subdued fill: the code/table band uses --md-code-bg-color #f5f5f5 in the default scheme; #1a1a1a in the slate scheme.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.102,
              0.102,
              0.102
            ],
            "alpha": 1,
            "hex": "#1a1a1a"
          }
        }
      }
    },
    "muted-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.4196,
          0.4196,
          0.4196
        ],
        "alpha": 1,
        "hex": "#6b6b6b"
      },
      "$description": "Secondary text: --md-default-fg-color--light as served is #6b6b6b in the default scheme; #a0a0a0 in the slate scheme.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.6275,
              0.6275,
              0.6275
            ],
            "alpha": 1,
            "hex": "#a0a0a0"
          }
        }
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9608,
          0.9608,
          0.9608
        ],
        "alpha": 1,
        "hex": "#f5f5f5"
      },
      "$description": "A hover fill: MkDocs menu items under the pointer take --md-default-bg-color--light #f5f5f5 in the default scheme; #1a1a1a in the slate scheme.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.102,
              0.102,
              0.102
            ],
            "alpha": 1,
            "hex": "#1a1a1a"
          }
        }
      }
    },
    "accent-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.3216,
          0.3216,
          0.3216
        ],
        "alpha": 1,
        "hex": "#525252"
      },
      "$description": "Text on a hover fill: --md-accent-fg-color as served is the grey #525252 in the default scheme; #d4d4d4 in the slate scheme.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.8314,
              0.8314,
              0.8314
            ],
            "alpha": 1,
            "hex": "#d4d4d4"
          }
        }
      }
    },
    "destructive": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.8353,
          0.1647,
          0.1647
        ],
        "alpha": 1,
        "hex": "#d52a2a"
      },
      "$description": "The error colour: --md-code-hl-number-color is #d52a2a in the default scheme; #e6695b in the slate scheme.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.902,
              0.4118,
              0.3569
            ],
            "alpha": 1,
            "hex": "#e6695b"
          }
        }
      }
    },
    "destructive-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "alpha": 1,
        "hex": "#ffffff"
      },
      "$description": "Text on the destructive colour: white, the page's on-strong-colour ink.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.0588,
              0.0588,
              0.0588
            ],
            "alpha": 1,
            "hex": "#0f0f0f"
          }
        }
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0,
          0
        ],
        "alpha": 0.12,
        "hex": "#000000"
      },
      "$description": "The hairline: --md-default-fg-color--lightest is black at 0.12 alpha in the default scheme; light ink at 0.12 in the slate scheme.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.8314,
              0.8314,
              0.8314
            ],
            "alpha": 0.12,
            "hex": "#d4d4d4"
          }
        }
      }
    },
    "input": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9608,
          0.9608,
          0.9608
        ],
        "alpha": 1,
        "hex": "#f5f5f5"
      },
      "$description": "The control surface: fields take the site's light fill --md-default-bg-color--light #f5f5f5, a step off the white canvas; #1a1a1a in the slate scheme.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.102,
              0.102,
              0.102
            ],
            "alpha": 1,
            "hex": "#1a1a1a"
          }
        }
      }
    },
    "ring": {
      "$value": "{color.accent-foreground}",
      "$description": "The focus ring follows the accent ink --md-accent-fg-color, the grey #525252 in the default scheme; #d4d4d4 in the slate scheme.",
      "$extensions": {
        "mode": {
          "dark": "{color.accent-foreground}"
        }
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": {
        "value": 0.1,
        "unit": "rem"
      },
      "$description": "The site's dominant corner radius: .1rem, the most frequent radius across its stylesheets."
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": {
      "$value": [
        "Roboto",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ],
      "$description": "The site's body typeface: Roboto, loaded via the Google Fonts stylesheet, ahead of a system sans fallback."
    },
    "mono": {
      "$value": [
        "Roboto Mono",
        "SFMono-Regular",
        "Menlo",
        "monospace"
      ],
      "$description": "The site's monospace face for code: Roboto Mono, with a system mono fallback."
    }
  }
}
