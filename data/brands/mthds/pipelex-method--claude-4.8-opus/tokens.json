{
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "alpha": 1,
        "hex": "#ffffff"
      },
      "$description": "The page canvas: --md-default-bg-color is #fff in the default (light) scheme.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.0588,
              0.0588,
              0.0588
            ],
            "alpha": 1,
            "hex": "#0f0f0f"
          }
        }
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.3216,
          0.3216,
          0.3216
        ],
        "alpha": 1,
        "hex": "#525252"
      },
      "$description": "Text on the canvas: --md-default-fg-color / --md-typeset-color as served is #525252 in light.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.8314,
              0.8314,
              0.8314
            ],
            "alpha": 1,
            "hex": "#d4d4d4"
          }
        }
      }
    },
    "card": {
      "$value": "{color.background}",
      "$description": "The site has no distinct card surface in light mode; a raised surface is the canvas.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.149,
              0.149,
              0.149
            ],
            "alpha": 1,
            "hex": "#262626"
          }
        }
      }
    },
    "card-foreground": {
      "$value": "{color.foreground}",
      "$description": "Text on a card is the page ink, in both modes."
    },
    "popover": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "alpha": 1,
        "hex": "#ffffff"
      },
      "$description": "A floating surface is the opaque canvas; derived from --md-default-bg-color #fff in light.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.149,
              0.149,
              0.149
            ],
            "alpha": 1,
            "hex": "#262626"
          }
        }
      }
    },
    "popover-foreground": {
      "$value": "{color.foreground}",
      "$description": "Text on a popover is the page ink, in both modes."
    },
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1019,
          0.1019,
          0.1019
        ],
        "alpha": 1,
        "hex": "#1a1a1a"
      },
      "$description": "The stated accent: #1a1a1a, the near-black the site shows on its primary surfaces.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.1019,
              0.1019,
              0.1019
            ],
            "alpha": 1,
            "hex": "#1a1a1a"
          }
        }
      }
    },
    "primary-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.898,
          0.898,
          0.898
        ],
        "alpha": 1,
        "hex": "#e5e5e5"
      },
      "$description": "Text on the accent: --md-primary-bg-color is #e5e5e5 against the near-black primary in the slate scheme.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.898,
              0.898,
              0.898
            ],
            "alpha": 1,
            "hex": "#e5e5e5"
          }
        }
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9608,
          0.9608,
          0.9608
        ],
        "alpha": 1,
        "hex": "#f5f5f5"
      },
      "$description": "A quiet filled surface: --md-code-bg-color / --md-default-bg-color--light is #f5f5f5 in light.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.1019,
              0.1019,
              0.1019
            ],
            "alpha": 1,
            "hex": "#1a1a1a"
          }
        }
      }
    },
    "secondary-foreground": {
      "$value": "{color.foreground}",
      "$description": "Text on a secondary surface is the page ink, in both modes."
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9804,
          0.9804,
          0.9804
        ],
        "alpha": 1,
        "hex": "#fafafa"
      },
      "$description": "A subdued fill: --md-default-bg-color--lighter is #fafafa in light.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.149,
              0.149,
              0.149
            ],
            "alpha": 1,
            "hex": "#262626"
          }
        }
      }
    },
    "muted-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.4196,
          0.4196,
          0.4196
        ],
        "alpha": 1,
        "hex": "#6b6b6b"
      },
      "$description": "Secondary text: --md-default-fg-color--light is #6b6b6b in light.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.6275,
              0.6275,
              0.6275
            ],
            "alpha": 1,
            "hex": "#a0a0a0"
          }
        }
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9608,
          0.9608,
          0.9608
        ],
        "alpha": 1,
        "hex": "#f5f5f5"
      },
      "$description": "A hover fill: --md-accent-bg-color--light is #f5f5f5 in light, the quiet fill under the pointer.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.2,
              0.2,
              0.2
            ],
            "alpha": 1,
            "hex": "#333333"
          }
        }
      }
    },
    "accent-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.3216,
          0.3216,
          0.3216
        ],
        "alpha": 1,
        "hex": "#525252"
      },
      "$description": "Text on a hover fill: --md-accent-fg-color as served is #525252 in light.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.8314,
              0.8314,
              0.8314
            ],
            "alpha": 1,
            "hex": "#d4d4d4"
          }
        }
      }
    },
    "destructive": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.8353,
          0.1647,
          0.1647
        ],
        "alpha": 1,
        "hex": "#d52a2a"
      },
      "$description": "The error colour: --md-code-hl-number-color is #d52a2a in light.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.902,
              0.4118,
              0.3569
            ],
            "alpha": 1,
            "hex": "#e6695b"
          }
        }
      }
    },
    "destructive-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "alpha": 1,
        "hex": "#ffffff"
      },
      "$description": "Text on the destructive colour: white, to read on the red mark.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.0588,
              0.0588,
              0.0588
            ],
            "alpha": 1,
            "hex": "#0f0f0f"
          }
        }
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0,
          0
        ],
        "alpha": 0.12,
        "hex": "#000000"
      },
      "$description": "The hairline: --md-default-fg-color--lightest is black at 12% in light.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.8314,
              0.8314,
              0.8314
            ],
            "alpha": 0.12,
            "hex": "#d4d4d4"
          }
        }
      }
    },
    "input": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9608,
          0.9608,
          0.9608
        ],
        "alpha": 1,
        "hex": "#f5f5f5"
      },
      "$description": "The control surface: the site's #f5f5f5 code/field fill, a step off the white canvas.",
      "$extensions": {
        "mode": {
          "dark": {
            "colorSpace": "srgb",
            "components": [
              0.1019,
              0.1019,
              0.1019
            ],
            "alpha": 1,
            "hex": "#1a1a1a"
          }
        }
      }
    },
    "ring": {
      "$value": "{color.primary}",
      "$description": "The focus ring follows the accent, the site's near-black primary, in both modes."
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": {
        "value": 0.1,
        "unit": "rem"
      },
      "$description": "The control corner radius: the site's most frequent radius is .1rem."
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": {
      "$value": [
        "Roboto",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ],
      "$description": "The site's typeface: Roboto, the most frequent family, with a system stack behind it."
    },
    "mono": {
      "$value": [
        "Roboto Mono",
        "SFMono-Regular",
        "Menlo",
        "monospace"
      ],
      "$description": "Tags, numbers and code: Roboto Mono, the site's monospace face, with the system stack behind it."
    }
  }
}
