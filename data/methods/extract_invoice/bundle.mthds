# Copied from the Pipelex methods library (MIT licence) - past this header, byte for byte:
# https://github.com/Pipelex/methods/blob/08367d9a0ca7206d866094ae97c7b4257716cc28/methods/invoice_extraction/invoice_extraction.mthds
# It is the cookbook's invoice extractor as the library carries it now: the page extraction
# inlined rather than imported, and an Invoice that states its currency and its line items.
# An AUTHORED method: the pipes are the author's, and nothing here is synthesized.
# The case is data/methods/extract_invoice/case.json; see scripts/generate-fixtures.mjs.

domain      = "invoice_extraction"
description = "Extracting structured invoice data from documents, supporting both formal bills and simple receipts"
main_pipe   = "process_invoice"

[concept.InvoiceDetails]
description = "Classification of the invoice type (formal bill vs simple receipt)"

[concept.InvoiceDetails.structure]
category = { type = "text", description = "The category of the invoice", choices = [
  "bill",
  "receipt",
] }
explanation = { type = "text", description = "Explanation of the classification" }

[concept.InvoiceLineItem]
description = "One priced line of an invoice or a receipt, as printed: a product, a service, a fee or a discount"

[concept.InvoiceLineItem.structure]
label      = { type = "text", description = "What the line is for, as printed: the product, service, fee or discount", required = true }
quantity   = { type = "number", description = "How many units, or how much, as printed; may be fractional for a weighed or measured item. Empty when the line prints no quantity" }
unit_price = { type = "number", description = "Price of one unit, in the invoice's currency, when the line prints it" }
amount     = { type = "number", description = "Total of the line, in the invoice's currency, as printed; negative for a discount or a refund" }

[concept.Invoice]
description = "Invoice information extracted from text, supporting both formal bills and receipts"

[concept.Invoice.structure]
invoice_id        = { type = "text", description = "Unique identifier for the invoice" }
invoice_number    = { type = "text", description = "Invoice number as shown on the document" }
issue_date        = { type = "date", description = "Date when the invoice was issued" }
time              = { type = "text", description = "Time of the transaction if available" }
amount_incl_tax   = { type = "number", description = "Total amount including taxes, in the invoice's currency" }
amount_excl_tax   = { type = "number", description = "Net amount excluding taxes, in the invoice's currency" }
vat_amount        = { type = "number", description = "Total VAT or tax amount, in the invoice's currency" }
currency          = { type = "text", description = "ISO 4217 code of the currency the invoice's totals and lines are expressed in, three uppercase letters such as EUR, USD or GBP; never the currency of a converted amount or of a card payment in another currency. Empty when the document does not determine it" }
vat_rates         = { type = "list", item_type = "number", description = "VAT rates applied, as percentages: 20 for 20 %" }
vendor            = { type = "text", description = "Name of the vendor/seller" }
vendor_address    = { type = "text", description = "Complete address of the vendor" }
vendor_siret      = { type = "text", description = "SIRET number of the vendor (French company registration)" }
vendor_vat_number = { type = "text", description = "VAT registration number of the vendor" }
company_name      = { type = "text", description = "Name of the purchasing company" }
company_address   = { type = "text", description = "Address of the purchasing company" }
description       = { type = "text", description = "One-line summary of what was purchased; the purchase line by line is in line_items" }
line_items        = { type = "list", item_type = "concept", item_concept_ref = "invoice_extraction.InvoiceLineItem", description = "The priced lines of the invoice, in the order printed, fees and discounts included; never the subtotal, tax, total or payment lines" }
category          = { type = "concept", concept_ref = "invoice_extraction.InvoiceDetails", description = "Category or type of expense" }
text              = { type = "text", description = "Raw text extracted from the invoice" }

[pipe.process_invoice]
type = "PipeSequence"
description = "Process relevant information from an invoice"
inputs = { document = "Document" }
output = "Invoice[]"
steps = [
  { pipe = "extract_invoice_pages", result = "invoice_pages" },
  { pipe = "extract_invoice", batch_over = "invoice_pages", batch_as = "invoice_page", result = "invoice" },
]

[pipe.extract_invoice_pages]
type            = "PipeExtract"
description     = "Extract page contents (text and images) from the invoice document, with full page views"
inputs          = { document = "Document" }
output          = "Page[]"
max_page_images = 5
page_views      = true

[pipe.extract_invoice]
type = "PipeSequence"
description = "Extract invoice information from an invoice page"
inputs = { invoice_page = "Page" }
output = "Invoice"
steps = [
  { pipe = "analyze_invoice", result = "invoice_details" },
  { pipe = "extract_invoice_data", result = "invoice" },
]

[pipe.analyze_invoice]
type = "PipeLLM"
description = "Analyze the invoice"
inputs = { invoice_page = "Page" }
output = "InvoiceDetails"
prompt = """
Analyze this invoice:

@invoice_page.text_and_images.text.text
"""

[pipe.extract_invoice_data]
type = "PipeLLM"
description = "Extract invoice information from an invoice text transcript and page view"
inputs = { invoice_details = "InvoiceDetails", invoice_page = "Page" }
output = "Invoice"
model = "$vision"
prompt = """
Extract invoice information from this invoice.

Currency: give the ISO 4217 code of the currency the invoice's own amounts are expressed in, its totals and its lines. Read it only from what qualifies those amounts, never from a converted amount, an exchange rate or a card-payment line printed in another currency. Take it from a currency code the document gives for those amounts, beside them or in a statement such as "all prices in EUR"; otherwise from a symbol printed with them that names one currency only, such as € or ₹; otherwise, for a symbol several currencies share, such as the dollar sign, the pound sign, the yen sign or kr, from where the document was issued, as the document itself shows it: the vendor's address, a city or a landmark in its name or header (an airport, a station), its phone number's format, its tax identifiers or the name its tax goes by. When nothing on the document settles it, or when the totals and lines are themselves in more than one currency, leave the currency empty rather than guess.

Line items: list every priced line of the document, in the order printed: each product or service, and each fee, deposit, surcharge, shipping charge or discount wherever it is printed, below the subtotal included, a discount or a refund having a negative amount. Never list the subtotal, tax, total, payment, tender or change lines, nor a line that only sums lines already listed, such as a subtotal per category. Take each line's quantity, unit price and amount as printed, leave out what the line does not print, and never compute a value the document does not show.

Description: summarize what was purchased in one line, without listing the items.

The category of this invoice is: $invoice_details.category.

{{ invoice_page.text_and_images.text.text|tag("ocr_extracted_text") }}

Page view: $invoice_page.page_view
"""
